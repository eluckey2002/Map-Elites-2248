{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Preregistration to Ledger",
    "output": "experiment-lifecycle.html",
    "quality_profile": "showcase",
    "views": [
      { "id": "preregister", "label": "Preregister", "focus": ["write_protocol", "register", "run"], "note": "The protocol is committed before any compute is spent; the commit is the timestamp." },
      { "id": "admit", "label": "Admit to the ledger", "focus": ["report", "gate", "ledger"], "note": "Every declared check must be answered in the report before the gate lets the record in." },
      { "id": "refusals", "label": "Where it stops", "focus": ["run", "refuse", "exploratory", "gate", "invalid"], "note": "Unregistered runs are refused up front; drifted or unanswered records are invalid." }
    ]
  },
  "lanes": [
    { "id": "experimenter", "label": "Experimenter · tools/new-experiment.js" },
    { "id": "script", "label": "Experiment script · experiment-guard.js" },
    { "id": "gate", "label": "Gate + ledger · tools/verify-experiments.js" },
    { "id": "exceptions", "label": "Refused or invalid", "variant": "exception" }
  ],
  "phases": [
    { "id": "preregister", "label": "Preregister", "fromCol": 0, "toCol": 1, "variant": "emphasis" },
    { "id": "run_phase", "label": "Run + report", "fromCol": 2, "toCol": 3 },
    { "id": "admit_phase", "label": "Admit", "fromCol": 4, "toCol": 5, "variant": "security" }
  ],
  "mainPath": ["write_protocol", "register", "run", "report", "gate", "ledger"],
  "nodes": [
    { "id": "write_protocol", "lane": "experimenter", "col": 0, "type": "frontend", "label": "Write protocol", "sublabel": "question, checks, predictions", "width": 150 },
    { "id": "register", "lane": "experimenter", "col": 1, "type": "security", "label": "Register + commit", "sublabel": "freeze hashes at HEAD", "tag": "clean tree only", "width": 150 },
    { "id": "run", "lane": "script", "col": 2, "type": "backend", "label": "Run --protocol", "sublabel": "guard checks the protocol", "tag": "stamps protocol commit", "width": 150 },
    { "id": "report", "lane": "experimenter", "col": 3, "type": "frontend", "label": "Write report.md", "sublabel": "every check answered", "width": 150 },
    { "id": "gate", "lane": "gate", "col": 4, "type": "security", "label": "Verify", "sublabel": "freeze, checks, citations", "tag": "run by test suite", "width": 150 },
    { "id": "ledger", "lane": "gate", "col": 5, "type": "database", "label": "Ledger record", "sublabel": "heuristic_observation admitted", "width": 150 },
    { "id": "refuse", "lane": "exceptions", "col": 2, "type": "security", "label": "Refused", "sublabel": "no committed protocol", "width": 150 },
    { "id": "exploratory", "lane": "exceptions", "col": 3, "type": "external", "label": "Exploratory", "sublabel": "stamped; cannot back a claim", "width": 150 },
    { "id": "invalid", "lane": "exceptions", "col": 4, "type": "security", "label": "Invalid record", "sublabel": "freeze drifted or unanswered", "tag": "supersede, never edit", "width": 150 }
  ],
  "edges": [
    { "from": "write_protocol", "to": "register", "label": "RESULT-NNNN" },
    { "from": "register", "to": "run", "label": "--protocol RESULT-NNNN", "variant": "emphasis" },
    { "from": "run", "to": "report", "label": "artifact written" },
    { "from": "report", "to": "gate", "label": "status: complete", "variant": "emphasis" },
    { "from": "gate", "to": "ledger", "label": "all checks answered", "variant": "security" },
    { "from": "run", "to": "refuse", "label": "no protocol", "variant": "security", "role": "error" },
    { "from": "run", "to": "exploratory", "label": "--exploratory", "variant": "dashed", "role": "branch" },
    { "from": "gate", "to": "invalid", "label": "any check fails", "variant": "security", "role": "error" }
  ],
  "cards": [
    { "dot": "emerald", "title": "The rule", "items": ["A generalizing claim states in advance what would falsify it", "Observations, exact results, and owner rulings need no protocol"] },
    { "dot": "rose", "title": "Stop conditions", "items": ["Scripts refuse to run without a committed protocol", "A frozen file that moves invalidates the record; supersede, never edit"] },
    { "dot": "cyan", "title": "Why the commit matters", "items": ["An uncommitted protocol has no point in time; it is not a preregistration", "The artifact carries the protocol commit; the gate checks the freeze"] }
  ]
