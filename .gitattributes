# Protocols are compared byte-for-byte against their registration commit
# (tools/verify-experiments.js protocolDrift), so git must never rewrite their
# line endings on checkout, whatever core.autocrlf says.
experiments/** text eol=lf

# Raw-byte identities are part of receipts and verification contracts. Keep
# repository text materialized exactly like its LF Git blobs on every host.
.gitattributes text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf

# These two legacy artifacts are committed with CRLF. Preserve their bytes;
# they are parsed as JSON and are not inputs to the raw-byte identity checks.
solver/candidate-levels.json -text -eol
solver/candidate-levels.receipt.json -text -eol
