# Store and check out every text file with LF, whatever core.autocrlf says on
# the machine. Shell scripts and hooks break under CRLF, and several tools here
# compare or hash files byte-for-byte.
* text=auto eol=lf

# Protocols are compared byte-for-byte against their registration commit
# (tools/verify-experiments.js protocolDrift), so git must never rewrite their
# line endings on checkout, whatever core.autocrlf says.
experiments/** text eol=lf

# Committed with CRLF and bound into receipts: never convert, or the recorded
# bytes stop matching.
solver/candidate-levels.json -text
solver/candidate-levels.receipt.json -text
