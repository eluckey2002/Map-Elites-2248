# Protocols are compared byte-for-byte against their registration commit
# (tools/verify-experiments.js protocolDrift), so git must never rewrite their
# line endings on checkout, whatever core.autocrlf says.
experiments/** text eol=lf

# Raw-byte identities appear in receipts, pilot bundles, experiment closures,
# and Universe Map verification. Materialize every text artifact with LF on
# every host so those identities bind Git content rather than checkout policy.
* text=auto eol=lf
#
# An existing Windows clone keeps its old CRLF checkouts after pulling this
# rule. Run `sh tools/refresh-line-endings.sh` once, from a clean tree.

# These legacy live-store blobs were committed with CRLF. They are parsed as
# JSON rather than hashed as raw input bytes, so retain their historical bytes
# until their own receipts are deliberately superseded.
solver/candidate-levels.json -text -eol
solver/candidate-levels.receipt.json -text -eol
