#!/bin/sh
# Refuse to push a red experiment gate to main.
#
# GitHub branch protection is unavailable on this private repository, so this
# hook is the refusal. Install once per clone (worktrees share it):
#   node tools/hooks/install.js
# Whenever any ref is pushed to refs/heads/main, it checks out the exact commit
# being pushed into a temporary worktree and runs the gates there, so a clean
# working tree cannot approve a red pushed commit (`git push origin other:main`)
# or reject a green one. Exits non-zero on failure.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
remote="$1"
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue   # deleting main is refused elsewhere
  echo "pre-push: gates on $local_sha for $remote/main" >&2
  tree=$(mktemp -d "${TMPDIR:-/tmp}/pre-push-XXXXXX")
  if ! git worktree add --quiet --detach "$tree" "$local_sha" >&2; then
    echo "pre-push: REFUSED — could not check out $local_sha to verify it." >&2
    rm -rf "$tree"
    exit 1
  fi
  failed=""
  (cd "$tree" && node tools/verify-experiments.js >&2) || failed="EXPERIMENT GATE"
  (cd "$tree" && node tools/verify-ledger-authorship.js >&2) || failed="$failed LEDGER AUTHORSHIP GATE"
  (cd "$tree" && node tools/ledger-index.js --check >&2) || failed="$failed LEDGER INDEX CHECK"
  git worktree remove --force "$tree" >&2
  if [ -n "$failed" ]; then
    echo "pre-push: REFUSED — FAILED:$failed. Fix the ledger before pushing to main." >&2
    exit 1
  fi
done
exit 0
